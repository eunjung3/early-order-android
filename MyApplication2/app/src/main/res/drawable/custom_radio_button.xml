<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 선택된 상태 -->
    <item android:state_checked="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android">
            <solid android:color="@android:color/white"/> <!-- 배경색 -->
            <stroke android:color="#533434" android:width="2dp"/> <!-- 테두리 색상 -->
            <corners android:radius="8dp"/> <!-- 둥근 모서리 -->
        </shape>
    </item>

    <!-- 선택되지 않은 상태 -->
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android">
            <solid android:color="@android:color/white"/> <!-- 배경색 -->
            <stroke android:color="#CCCCCC" android:width="2dp"/> <!-- 기본 테두리 색상 -->
            <corners android:radius="8dp"/> <!-- 둥근 모서리 -->
        </shape>
    </item>
</selector>
