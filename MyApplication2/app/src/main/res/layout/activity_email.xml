<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".EmailActivity">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_b2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_gravity="center_vertical"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="16dp"
            android:text="이메일 인증"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_email"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="입력한 이메일 주소"
        android:textColor="#666666"
        android:textSize="16sp"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout"/>

    <LinearLayout
        android:id="@+id/linear_code_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="26dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_email"
        android:layout_marginTop="16dp">

        <EditText
            android:id="@+id/ed_code1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:maxLength="1"
            android:inputType="textCapCharacters"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:textAlignment="center"
            android:background="@drawable/edit_text_background"/>

        <EditText
            android:id="@+id/ed_code2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:maxLength="1"
            android:inputType="textCapCharacters"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:textAlignment="center"
            android:background="@drawable/edit_text_background"/>

        <EditText
            android:id="@+id/ed_code3"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:maxLength="1"
            android:inputType="textCapCharacters"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:textAlignment="center"
            android:background="@drawable/edit_text_background"/>

        <EditText
            android:id="@+id/ed_code4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:maxLength="1"
            android:inputType="textCapCharacters"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:textAlignment="center"
            android:background="@drawable/edit_text_background"/>

        <EditText
            android:id="@+id/ed_code5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:maxLength="1"
            android:inputType="textCapCharacters"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:textAlignment="center"
            android:background="@drawable/edit_text_background"/>

        <EditText
            android:id="@+id/ed_code6"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:maxLength="1"
            android:inputType="textCapCharacters"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textAlignment="center"
            android:background="@drawable/edit_text_background"/>
    </LinearLayout>

    <Button
        tools:ignore="MissingConstraints"
        android:id="@+id/btn_resend_code"
        android:textColor="#533434"
        android:layout_width="200dp"
        android:layout_height="50dp"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:text="인증 코드 재전송"
        android:textSize="14sp"
        android:drawable="@null"
        app:layout_constraintTop_toBottomOf="@+id/tv_timer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tv_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="32dp"
        android:text="03:00"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/linear_code_input"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_error_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="32dp"
        android:textColor="@android:color/holo_red_light"
        android:visibility="gone"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@+id/linear_code_input"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_verify"
        android:layout_width="230dp"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        android:backgroundTint="#836043"
        android:text="인증 확인"
        android:textColor="@android:color/white"
        app:cornerRadius="16dp"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_resend_code"
        tools:ignore="MissingConstraints" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"/>

</androidx.constraintlayout.widget.ConstraintLayout>
